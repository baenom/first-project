# SyncRoom (gam) 디스코드 봇 환경 설정 파일
# 이 파일을 복사하여 .env 로 이름을 변경한 후 실제 토큰 값을 입력하세요.

# 1. 디스코드 봇 토큰 (필수)
# 발급처: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN="여기에_디스코드_봇_토큰을_입력하세요"

# 2. Tailscale API 키 (추천: 서울 DERP-9 연동 10~20ms 초저지연 가상 회선 1회용 키 자동 생성)
# 발급처: https://login.tailscale.com/admin/settings/keys -> Generate access token
TAILSCALE_API_KEY="tskey-api-..."
TAILSCALE_TAILNET="-"

# 3. ZeroTier Central API 토큰 (보조 가상 랜)
# 발급처: https://my.zerotier.com/ -> Account -> Access Tokens -> Generate New Token
ZEROTIER_API_TOKEN="여기에_ZeroTier_API_토큰을_입력하세요"

# 4. 원클릭 리다이렉트 HTTP 포트 (기본값: 8765)
HTTP_PORT=8765

# 5. 외부 접속용 리다이렉트 베이스 URL (선택)
# 같은 PC 로컬 테스트 시: http://localhost:8765
# 공인 IP나 도메인 사용 시: http://내공인ip:8765
REDIRECT_BASE_URL="http://localhost:8765"
